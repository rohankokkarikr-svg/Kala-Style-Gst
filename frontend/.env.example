# KalaStyle AI Frontend Environment Configuration
REACT_APP_API_URL=https://your-render-backend-url.onrender.com/api
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
# Preferred modern publishable key (or legacy anon key)
REACT_APP_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay PUBLIC Key ID only
# NEVER put RAZORPAY_KEY_SECRET in frontend!
REACT_APP_RAZORPAY_KEY_ID=your_public_razorpay_key_id
