PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Twilio (WhatsApp Notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_CONTENT_SID=your_twilio_content_sid

# Google Gemini AI Admin Manager (Autonomous Platform Brain)
# Get from https://aistudio.google.com/app/apikey
GEMINI_ADMIN_API_KEY=your_gemini_admin_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_AUTONOMOUS_MODE=true

# Razorpay Payment Gateway (Test Mode / Live Mode)
# Backend requires Key ID, Key Secret, and Webhook Secret
# NEVER commit real credentials to Git!
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend URL for CORS in production
FRONTEND_URL=https://kalastyle.netlify.app

