PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Supabase Configuration (Server-Only)
# Canonical modern variable: SUPABASE_SECRET_KEY (supports sb_secret_... opaque key)
# Backward-compatible aliases: SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SERVICE_KEY
# SECURITY: Set as Render/server environment secrets. NEVER commit to Git or ZIPs.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI Admin Manager (Autonomous Platform Brain)
# Get from https://aistudio.google.com/app/apikey
GEMINI_ADMIN_API_KEY=your_gemini_admin_api_key_here
# Recommended model: gemini-3.5-flash-lite (high free tier quota: 15 RPM / 1,500 RPD)
# Note: gemini-3.6-flash free tier is restricted to 20 requests/day.
GEMINI_MODEL=gemini-3.5-flash-lite
AI_AUTONOMOUS_MODE=true

# Razorpay Payment Gateway (Test Mode / Live Mode)
# Backend requires Key ID, Key Secret, and Webhook Secret
# NEVER commit real credentials to Git!
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend URL for CORS in production (Render)
FRONTEND_URL=https://kala-style-frontend.onrender.com

# ─── Shiprocket Shipping & Logistics Integration ──────────────────────────────
# Set SHIPPING_PROVIDER=shiprocket for live Shiprocket API or 'mock' for local development/demos
SHIPPING_PROVIDER=shiprocket
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_DEFAULT_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret_here

# Package dimension & weight defaults (metric: kg, cm)
SHIPMENT_DEFAULT_WEIGHT=0.5
SHIPMENT_DEFAULT_LENGTH=20
SHIPMENT_DEFAULT_BREADTH=20
SHIPMENT_DEFAULT_HEIGHT=10

# ─── Checkout Phone OTP — Twilio Verify (REQUIRED for SMS verification) ───────
# 1. Create a Twilio account at https://www.twilio.com
# 2. Create a Verify Service at https://console.twilio.com/us1/develop/verify/services
# 3. Set CHECKOUT_PHONE_OTP_ENABLED=true and fill in credentials below.
# IMPORTANT: Keep ALL Twilio credentials server-side only.
#            NEVER use REACT_APP_ prefix for any of these.
#            NEVER commit real values to source control.
CHECKOUT_PHONE_OTP_ENABLED=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: default country code prefix for 10-digit number normalization (default: +91)
CHECKOUT_OTP_COUNTRY_CODE=+91

# ─── AI Agent Rate Limiting ────────────────────────────────────────────────────
# Set DISABLE_RATE_LIMITS=true in development if you hit 429 errors during testing
DISABLE_RATE_LIMITS=false
# Chat: max requests per minute per admin (default 10)
AGENT_RATE_MAX_CHAT=10
AGENT_RATE_WINDOW_MS=60000
# Admin AI endpoints: max requests per minute (default 60)
ADMIN_AI_RATE_MAX=60
ADMIN_AI_RATE_WINDOW_MS=60000
# Auth: max login attempts per 15 min (default 20)
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW_MS=900000
# Checkout Phone OTP rate limits & development mode
CHECKOUT_OTP_SEND_RATE_MAX=5
CHECKOUT_OTP_VERIFY_RATE_MAX=10
ALLOW_DEV_PHONE_OTP=false
DEV_OTP_CODE=123456

# ─── Agent Memory & Approval Config ───────────────────────────────────────────
# Hours before a pending approval expires (default: 24)
AGENT_APPROVAL_EXPIRY_HOURS=24

# ─── Direct SMTP Mailer Configuration (Pure 8-Digit OTP, Zero Confirm Links) ──
# Optional: Provide SMTP credentials to send pure numeric OTPs directly via email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="KalaStyle AI" <noreply@kalastyle.ai>
